{
  "name": "ytestbook",
  "version": "0.2.2",
  "private": true,
  "main": "src/index.tsx",
  "type": "module",
  "scripts": {
    "dev": "npm run start",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "start": "vite --host",
    "test": "vitest",
    "docker:build": "docker build -t registry.intesys.it/dolomiti-sharedtracking/ytestbook:latest .",
    "docker:run": "docker run -d -p 80:80 registry.intesys.it/dolomiti-sharedtracking/ytestbook:latest",
    "docker:submit": "docker push registry.intesys.it/dolomiti-sharedtracking/ytestbook:latest",
    "k8s:restart": "kubectl rollout restart deployment ytestbook-deployment -n dolomiti-sharedtracking"
  },
  "dependencies": {
    "@automerge/automerge": "3.1.2",
