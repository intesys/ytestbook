    "@tiptap/extension-underline": "3.4.5",
    "@tiptap/react": "3.4.5",
    "@tiptap/starter-kit": "3.4.5",
    "clsx": "2.1.1",
    "compressorjs": "1.2.1",
    "dayjs": "1.11.18",
    "es-toolkit": "1.39.10",
